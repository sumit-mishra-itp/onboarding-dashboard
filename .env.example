# Copy to .env. Dev needs nothing; hosting needs the three marked REQUIRED.

# REQUIRED for hosting: random, 32+ chars. Generate with: openssl rand -hex 32
SESSION_SECRET=
# REQUIRED for hosting: the Postgres password (docker-compose.prod.yml)
POSTGRES_PASSWORD=
# Hosting: port nginx listens on. Put HTTPS in front of it; session cookies are Secure-only.
HTTP_PORT=80

# AI drafting. AI_PROVIDER is groq | gemini | anthropic; only that provider's key is needed.
# REQUIRED for AI: leave the key empty and the plan builder falls back to manual entry.
AI_PROVIDER=groq
# Empty = provider default (groq: openai/gpt-oss-120b, gemini: gemini-2.5-flash, anthropic: claude-opus-5)
AI_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional tuning
# SESSION_MAX_AGE=43200   # seconds of inactivity before sign-out (default 12h)
# DB_POOL_MAX=20          # connections per API worker (2 workers)
